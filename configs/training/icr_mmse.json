{
  "datasets": {
    "NOF1": "data/processed/nof1_compact_20261026_final",
    "NCS1": "data/processed/ncs1_compact_20261026_nmse"
  },
  "output": "outputs/runs/icr_mmse_current",
  "input_view": "compensated",
  "model": {
    "layers": 8,
    "bandwidth": 16,
    "precision": "complex64",
    "noise_mode": "diagonal",
    "correction_mode": "iterative",
    "detector_mode": "budgeted",
    "initial_soft_damping": 0.8,
    "initial_csi_loading": 0.01,
    "window_size": 32,
    "center_size": 16,
    "hidden_size": 48,
    "use_uncertainty": true,
    "use_gate": true
  },
  "training": {
    "detector_parameters": "all",
    "neural_learning_rate_scale": 1.0,
    "stage_epochs": [
      10,
      10,
      10
    ],
    "lambda_h": 0.1,
    "batch_size": 8,
    "learning_rate": 0.001,
    "stage_c_learning_rate": 0.0001,
    "stage_c_correction_learning_rate": 1e-05,
    "seed": 20261028,
    "operator_backend": "dense_device",
    "prefetch_batches": 2,
    "reference_cache_mib": 8192,
    "sample_order": "snr_interleaved",
    "loss_options": {
      "objective": "bit_ce",
      "final_weight": 0.9
    }
  },
  "channel_overrides": {
    "NOF1": {
      "training": {
        "lambda_h": 0.01,
        "neural_learning_rate_scale": 0.01
      },
      "warmup_training": {
        "lambda_h": 0.01,
        "learning_rate": 0.001
      }
    },
    "NCS1": {
      "model": {
        "initial_csi_loading": 0.1
      },
      "training": {
        "lambda_h": 1.0
      },
      "warmup_training": {
        "lambda_h": 0.1,
        "learning_rate": 0.0003
      }
    }
  },
  "selection": {
    "enabled": false,
    "seeds": [
      20261028
    ]
  },
  "evaluation": {
    "batch_size": 2,
    "bootstrap_samples": 2000,
    "include_baselines": true
  }
}

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
.ipynb_checkpoints/
/tmp/
/torchinductor_*/

# Local environments
.venv/
venv/
.env
.env.*
!.env.example

# Datasets: retain the directory structure
/data/**
!/data/**/
!/data/**/.gitkeep

# Experiment outputs: retain the directory structure
/outputs/**
!/outputs/**/
!/outputs/**/.gitkeep

# Preserve local historical snapshots without traversing nested worktrees/caches
/outputs/runs/archive/
